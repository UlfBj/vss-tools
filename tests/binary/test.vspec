#
A:
  type: branch
  description: Branch A.

A.String:
  datatype: string
  type: sensor
  description: A string

A.Int:
  datatype: uint16
  type: actuator
  description: An int

A.AllowedFloat:
  datatype: float
  allowed:
  - 1.1
  - 2.54
  - 3
  description: A list of allowed floats
  type: actuator

A.AllowedInt:
  datatype: uint16
  allowed:
  - 0
  - 10
  - 20
  type: actuator
  description: A list of allowed ints

A.AllowedString:
  datatype: string
  allowed:
  - A
  - B
  type: actuator
  description: A list of allowed strings

A.EnumUint8:
  datatype: uint8
  enum:
    'AKITA': 0
    'BOXER': 1
    'CHOW_CHOW': 5
  default: 1
  type: attribute
  description: An enum

A.EnumUint8Array:
  datatype: uint8[]
  enum:
    'AKITA': 0
    'BOXER': 1
  type: attribute
  description: An enum array
